# Mailtrap Configuration (For Development/Testing)
# Sign up free at: https://mailtrap.io
MAIL_DRIVER=smtp
MAIL_HOST=live.smtp.mailtrap.io
MAIL_PORT=587
MAIL_USERNAME=your_mailtrap_username
MAIL_PASSWORD=your_mailtrap_password
MAIL_ENCRYPTION=tls
MAIL_FROM_ADDRESS=noreply@stjosephparish.com
MAIL_FROM_NAME=St. Joseph Parish

# GMS SMS Configuration (if you have GMS Philippines account)
GMS_API_KEY=YOUR_GMS_API_KEY_HERE
GMS_API_SECRET=YOUR_GMS_API_SECRET_HERE
GMS_SENDER_ID=STJOSEPH

# Semaphore SMS (Alternative to GMS)
SEMAPHORE_API_KEY=YOUR_SEMAPHORE_API_KEY_HERE
