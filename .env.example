# St. Joseph Parish System - Environment Configuration
# Copy this file to .env and fill in your credentials

# ===========================
# GMS SMS Gateway Configuration
# ===========================
# Get these from: https://www.gms.ph/
GMS_API_KEY=your_gms_api_key_here
GMS_API_SECRET=your_gms_api_secret_here
GMS_SENDER_ID=STJOSEPH

# ===========================
# Semaphore SMS Gateway (Alternative)
# ===========================
# Get this from: https://semaphore.co/
# SEMAPHORE_API_KEY=your_semaphore_api_key_here

# ===========================
# Free SMS Fallback (Optional)
# ===========================
# Some carriers support email-to-SMS delivery for free.
# Example: FREE_SMS_GATEWAY=txt.att.net
# Or a full template: FREE_SMS_GATEWAY={{phone}}@yourdomain.com
FREE_SMS_GATEWAY=

# ===========================
# Email Configuration (Optional SMTP)
# ===========================
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USERNAME=your-email@gmail.com
# SMTP_PASSWORD=your-app-password
# SMTP_FROM_EMAIL=noreply@stjosephparish.com

# ===========================
# Database Configuration
# ===========================
# DB_HOST=localhost
# DB_USER=root
# DB_PASSWORD=
# DB_NAME=josephus_parish_system

# ===========================
# Application Settings
# ===========================
# APP_NAME=St. Joseph Parish Management System
# APP_ENV=development
# APP_DEBUG=true
